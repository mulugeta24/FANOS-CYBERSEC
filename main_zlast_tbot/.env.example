# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# VirusTotal API Configuration (Optional but recommended)
VT_API_KEY=your_virustotal_api_key_here

# Admin Configuration
# Comma-separated list of Telegram user IDs who have admin access
# To get your user ID, message @userinfobot on Telegram
ADMIN_USER_IDS=123456789,987654321

# Admin Password for user authentication
# Users must use /start <password> to authenticate
ADMIN_PASSWORD=your_secure_password_here

# Web API Configuration
SECRET_KEY=your_secret_jwt_key_here
ADMIN_USERNAME=admin

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/malicious_url_detector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=malicious_url_detector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

